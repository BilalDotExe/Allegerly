# Copy this file to .env and fill in real values.
# Never commit .env — it holds secrets.

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Timestamps are stored in UTC and shown in this zone. Set it to where the
# business actually is, or the audit log will read hours out.
# Any IANA name works, e.g. America/Chicago, America/Los_Angeles, Asia/Karachi.
TIME_ZONE=America/New_York

# Set True only after HTTPS is confirmed working in production.
ENABLE_HSTS=False
